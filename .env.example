# Copy this file to .env for local development. Never commit the resulting
# .env file because it may later contain machine-specific or secret values.

# Absolute WSL path to the external historical dataset directory.
# Keep the dataset outside this repository. Future containers must mount this
# directory read-only and must not copy its CSV or ZIP files into the project.
DATASET_PATH=/mnt/c/Users/Minh/Desktop/hust/big_data/project/dataset

# Stable Docker Compose project name for future local services.
COMPOSE_PROJECT_NAME=realtime-ecommerce-analytics
